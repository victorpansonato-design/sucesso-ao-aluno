# Copie para .env.local (que o git ignora) e preencha.

# De onde vêm os dados da interface:
#   mock = dados fictícios gerados no navegador, no formato exato da API (padrão)
#   api  = API real do TI, através do proxy /api/evasao
VITE_DATA_SOURCE=mock

# --- Só no servidor. NUNCA coloque prefixo VITE_ nestas duas. ---------------
# Token Bearer da API (peça ao TI ou veja api/lib/config.php no app-web).
EVASAO_API_TOKEN=
# Base da API. Vazio = produção do app-web.
EVASAO_API_BASE=https://app.anchieta.br/api_evasao_grad_presencial/api
